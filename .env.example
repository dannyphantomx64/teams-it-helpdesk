# Bot Framework
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=

# Azure AD (for SharePoint access)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_KEY=

# SharePoint Knowledge Source
SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/ITKnowledgeBase
SHAREPOINT_DRIVE_ID=

# Azure AI Search (production — omit for in-memory dev store)
KNOWLEDGE_BASE_CONNECTION_STRING=Endpoint=https://your-search.search.windows.net;ApiKey=your-key;Index=it-helpdesk-index

# Bot Behavior
CONFIDENCE_THRESHOLD=0.7
TOP_N=5
PORT=3978
NODE_ENV=development

# Scheduled Re-indexing
INDEX_INTERVAL_MINUTES=60

# Conversation Memory
MAX_CONVERSATION_TURNS=10

# Escalation Webhooks (all optional — configure the ones you use)
ESCALATION_WEBHOOK_URL=
SERVICENOW_WEBHOOK_URL=
JIRA_WEBHOOK_URL=

# Multi-language Support
ENABLE_TRANSLATION=false

# Question Logging
LOG_DIR=./logs
