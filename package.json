  "description": "Microsoft Teams IT Help Desk bot with RAG-powered knowledge base and ticket escalation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
